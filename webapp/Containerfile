FROM registry.access.redhat.com/ubi9/ubi-minimal:latest

ARG OCP_VERSION=4.22.0
ARG CPU_ARCH=x86_64

# openssl is needed for self-signed TLS cert generation in entrypoint.sh.
RUN microdnf install -y python3-pip nmstate openssl && \
    microdnf clean all

# Download openshift-install pinned to the same OCP version as the appliance.
# This version must match appliance-config.yaml ocpRelease.version.
RUN curl -sL \
    "https://mirror.openshift.com/pub/openshift-v4/${CPU_ARCH}/clients/ocp/${OCP_VERSION}/openshift-install-linux.tar.gz" \
    | tar -xz -C /usr/local/bin openshift-install && \
    chmod +x /usr/local/bin/openshift-install

WORKDIR /webapp
COPY requirements.txt .
RUN pip3 install --no-cache-dir -r requirements.txt

COPY . .
RUN chmod +x entrypoint.sh

# APPLIANCE_ISO_URL: URL where appliance.iso is hosted (S3, CDN, etc.)
# OPENSHIFT_INSTALL_BIN / NMSTATECTL_BIN: override binary paths (for local dev)
# TLS_DISABLED: set to "true" to run plain HTTP (e.g. behind a TLS-terminating proxy)
# TLS_CERT_FILE / TLS_KEY_FILE: paths to an existing cert+key (skip auto-generation)
# PORT: listening port (default 8443 with TLS, 8000 with TLS_DISABLED=true)
ENV APPLIANCE_ISO_PATH="" \
    APPLIANCE_ISO_URL="" \
    OPENSHIFT_INSTALL_BIN="" \
    NMSTATECTL_BIN="" \
    TLS_DISABLED="" \
    TLS_CERT_FILE="" \
    TLS_KEY_FILE="" \
    PORT=""
# AUTH_USERNAME and AUTH_PASSWORD are intentionally not set here —
# they carry credentials and should be supplied at runtime only.

EXPOSE 8443

ENTRYPOINT []
CMD ["./entrypoint.sh"]
